# Salin menjadi .env.local untuk pengembangan, dan isikan juga ke
# Vercel -> Project Settings -> Environment Variables.
#
# Keduanya diambil dari Supabase: Settings -> API.

# Alamat project, contoh: https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=

# Kunci "anon public". Kunci ini memang boleh terlihat di peramban —
# yang menjaga data adalah RLS di sisi database, bukan kerahasiaan kunci ini.
VITE_SUPABASE_ANON_KEY=

# JANGAN pernah menaruh service_role key di sini atau di kode mana pun yang
# dikirim ke peramban. Kunci itu melewati seluruh aturan RLS.
